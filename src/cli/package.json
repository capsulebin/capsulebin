{
    "name": "@capsulebin/cli",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "license": "AGPL-3.0-only",
    "description": "CapsuleBin command line client",
    "bin": {
        "capsulebin": "./dist/cli.js"
    },
    "scripts": {
        "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/cli.js",
        "check": "tsc --noEmit",
        "test": "vitest run"
    },
    "devDependencies": {
        "@types/node": "^22.19.0",
        "esbuild": "^0.25.0",
        "typescript": "~7.0.2",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@capsulebin/core": "*"
    }
}
