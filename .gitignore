/target
/node_modules
/src/*/node_modules
/src/server/web/node_modules
/src/server/web/dist
/src/cli/dist

# Local development data - contains ciphertext and is never part of the repo.
*.db
*.db-wal
*.db-shm
/data
/capsulebin.dev.toml.local
